<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 authoring for the ClutterCutter MSI. Produces a per-machine installer
  that network admins can deploy silently (GPO software installation / SCCM /
  Intune):  msiexec /i ClutterCutter.msi /qn
  It installs ClutterCutter.exe into Program Files and adds an all-users Start
  Menu shortcut. MajorUpgrade means re-running a newer MSI upgrades in place.

  Built in CI (build.yml) with:
    candle -arch x64 -dVersion=<x.y.z> -dExeSource=ClutterCutter.exe \
           -dIconSource=ClutterCutter.ico msi/ClutterCutter.wxs -o cc.wixobj
    light  cc.wixobj -o ClutterCutter.msi

  The UpgradeCode below is STABLE across all versions — never change it, or
  upgrades will stop working.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="ClutterCutter"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Struis ICT"
           UpgradeCode="FADE883B-0102-4A40-A367-3E96BD9692F7">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="ClutterCutter - fast disk-usage browser"
             Comments="https://github.com/StruisICT/ClutterCutter" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of ClutterCutter is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!--
      Launch-after-install (fleet-safe by design):
        * Interactive installs (double-click, or an interactive winget install;
          UILevel greater than or equal to 4) launch ClutterCutter once when
          setup finishes.
        * Silent installs stay quiet by DEFAULT, so GPO / SCCM / Intune rollouts
          never spawn the app on every machine. A silent install can still opt in
          by passing LAUNCHAFTERINSTALL=1 (the winget silent switches set this),
          which queues an HKLM RunOnce that fires once at the next sign-in. No
          SYSTEM-to-user process spawn is used anywhere, so nothing looks like the
          malware pattern that trips Microsoft Defender.
      The immediate launch is a plain type-18 (installed-file) custom action, so
      it needs no WiX extension and the CI candle/light calls stay unchanged.
    -->
    <Property Id="LAUNCHAFTERINSTALL" Secure="yes" />
    <CustomAction Id="LaunchApplication"
                  FileKey="ClutterCutterExe"
                  ExeCommand=""
                  Impersonate="yes"
                  Return="asyncNoWait" />
    <InstallExecuteSequence>
      <!-- Fresh interactive install only (not silent, not repair/uninstall). -->
      <Custom Action="LaunchApplication" After="InstallFinalize">NOT Installed AND UILevel&gt;=4</Custom>
    </InstallExecuteSequence>

    <!-- Add/Remove Programs metadata -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.IconSource)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/StruisICT/ClutterCutter" />
    <Property Id="ARPURLINFOABOUT" Value="https://struisict.com" />

    <Feature Id="Main" Title="ClutterCutter" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="LaunchOnceRunKey" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ClutterCutter">
          <Component Id="MainExe" Guid="*">
            <File Id="ClutterCutterExe"
                  Source="$(var.ExeSource)"
                  Name="ClutterCutter.exe"
                  KeyPath="yes" />
          </Component>

          <!-- Opt-in one-time launch for SILENT installs (LAUNCHAFTERINSTALL=1):
               queue the installed exe in HKLM RunOnce so it starts once at the
               next sign-in. The component keypath is a separate, stable value so
               a later repair won't re-queue the launch after RunOnce self-deletes.
               Without the property this component isn't installed at all, so plain
               `/qn` fleet installs write nothing. -->
          <Component Id="LaunchOnceRunKey" Guid="7B2F5A6C-9D3E-4C1A-8F0B-2E4D6A8C1B37">
            <Condition>LAUNCHAFTERINSTALL=1</Condition>
            <RegistryValue Root="HKLM"
                           Key="Software\StruisICT\ClutterCutter"
                           Name="launchQueued"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
            <RegistryValue Root="HKLM"
                           Key="Software\Microsoft\Windows\CurrentVersion\RunOnce"
                           Name="ClutterCutterFirstRun"
                           Type="string"
                           Value="&quot;[INSTALLFOLDER]ClutterCutter.exe&quot;" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="B46C9096-58A8-4159-AD83-1E002A4230AB">
          <Shortcut Id="StartMenuShortcut"
                    Name="ClutterCutter"
                    Description="Fast disk-usage browser"
                    Target="[INSTALLFOLDER]ClutterCutter.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico" />
          <RemoveFolder Id="RemoveProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKLM"
                         Key="Software\StruisICT\ClutterCutter"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
  </Product>
</Wix>
